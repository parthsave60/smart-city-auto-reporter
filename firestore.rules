rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAuthority() {
      return isSignedIn() && (
        request.auth.token.email in [
          '124@sjcem.edu.in',
          '124parth4014@sjcem.edu.in', 
          '124parh4014@sjcme.edu.in', 
          'admin@smartcity.com',
          'maithilpatil9@gmail.com',
          'harshstawde@gmail.com',
          'satyambhagat200623@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'authority')
      );
    }

    // Issues Collection
    match /issues/{issueId} {
      // Authority can read all issues; Citizens can read only their own
      allow read: if isAuthority() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Authenticated users can create issues with their own userId
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only Authority can update status and delete reports
      allow update: if isAuthority();
      allow delete: if isAuthority();
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAuthority();
    }
    
    // Users Collection
    match /users/{userId} {
      // Users can read own profile; Authorities can inspect user profiles
      allow read: if isOwner(userId) || isAuthority();
      // On creation, normal users can only set role to 'citizen'
      allow create: if isOwner(userId) && (request.resource.data.role == 'citizen' || isAuthority());
      // Users cannot change their own role (prevent privilege escalation)
      allow update: if isAuthority() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAuthority();
    }
  }
}
